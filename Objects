public class Employee {
    String name;
    int id;
    double salary;

    void displayDetails() {
        System.out.println("ID: " + id);
        System.out.println("Name: " + name);
        System.out.println("Salary: " + salary);
        System.out.println();
    }
}
public class Main {
    public static void main(String[] args) {

        Employee emp1 = new Employee();
        Employee emp2 = new Employee();
        Employee emp3 = new Employee();

        emp1.id = 101;
        emp1.name = "Arun";
        emp1.salary = 30000;

        emp2.id = 102;
        emp2.name = "Rahul";
        emp2.salary = 35000;

        emp3.id = 103;
        emp3.name = "Priya";
        emp3.salary = 40000;

        emp1.displayDetails();
        emp2.displayDetails();
        emp3.displayDetails();
    }
}